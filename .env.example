APP_ENV=development
HTTP_ADDR=:8080
SHUTDOWN_WAIT=15s
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
OIDC_ISSUER=http://localhost:8081/realms/wallet
OIDC_AUDIENCE=wallet-api

SQS_VISIBILITY_TIMEOUT=30
SQS_WAIT_TIME_SECONDS=1
SQS_MAX_RECEIVE_COUNT=5
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_DURATION=30s
OUTBOX_POLL_INTERVAL=1s
REFERENCE_BATCH_SIZE=100
REFERENCE_MAX_ATTEMPTS=8
REFERENCE_BASE_BACKOFF=1s
REFERENCE_MAX_BACKOFF=1h
REFERENCE_TTL=24h
